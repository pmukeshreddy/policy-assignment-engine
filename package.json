{
  "name": "policy-assignment-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned, dependency-aware policy assignment engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker-main.ts",
    "worker:start": "node dist/src/worker-main.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:start": "node dist/scripts/migrate.js",
    "db:reset": "tsx scripts/reset-db.ts",
    "data:nyc": "tsx scripts/import-nyc.ts",
    "data:nyc:start": "node dist/scripts/import-nyc.js",
    "eval:regression": "tsx scripts/run-regression-eval.ts",
    "eval:regression:start": "node dist/scripts/run-regression-eval.js",
    "test": "vitest run --exclude tests/integration/**",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration --pool=forks --poolOptions.forks.singleFork=true",
    "test:all": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "validate": "npm run lint && npm run typecheck && npm run test:all && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.9.1",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}
